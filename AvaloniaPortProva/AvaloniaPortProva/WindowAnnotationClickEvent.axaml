<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:teechart="clr-namespace:Steema.TeeChart.Avalonia;assembly=TeeChart.Avalonia"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaPortProva.WindowAnnotationClickEvent"
        Title="WindowAnnotationClickEvent"
		WindowStartupLocation="CenterScreen">
	<Grid>
		<teechart:TChart Name="TChart"/>
		<Button Content="Tornar Enrere" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Click="onClick_Tornar"/>

	</Grid>
</Window>
		